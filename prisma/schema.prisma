// ============================================================
// Prisma Schema — AI Gmail Assistant Database
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Users ────────────────────────────────────────────────────

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  image               String?
  googleAccessToken   String?  @map("google_access_token")
  googleRefreshToken  String?  @map("google_refresh_token")
  tokenExpiresAt      DateTime? @map("token_expires_at")
  writingStyleProfile Json?    @map("writing_style_profile") // Learned writing style
  priorityPreferences Json?    @map("priority_preferences")  // Custom priority rules
  settings            Json?    // General app settings
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  processedEmails ProcessedEmail[]
  reminders       Reminder[]
  feedbacks       UserFeedback[]

  @@map("users")
}

// ─── Processed Emails ─────────────────────────────────────────

model ProcessedEmail {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  gmailMessageId String   @map("gmail_message_id")
  gmailThreadId  String?  @map("gmail_thread_id")
  fromAddress    String   @map("from_address")
  fromName       String?  @map("from_name")
  subject        String

  // Agent 1: Inbox Analyzer output
  extractedEntities Json?    @map("extracted_entities")
  detectedIntent    String?  @map("detected_intent")
  detectedLanguage  String?  @map("detected_language")
  needsReply        Boolean  @default(false) @map("needs_reply")
  sentiment         String?
  wordCount         Int?     @map("word_count")

  // Agent 2: Priority Classifier output
  priorityLevel   Int?     @map("priority_level")   // 0-4
  priorityLabel   String?  @map("priority_label")
  priorityScore   Int?     @map("priority_score")    // 0-100
  priorityFactors Json?    @map("priority_factors")
  routingDecision Json?    @map("routing_decision")

  // Agent 3: Summary Generator output
  summaryOneLiner String?  @map("summary_one_liner")
  summaryDetailed Json?    @map("summary_detailed")
  actionItems     Json?    @map("action_items")
  keyDecisions    Json?    @map("key_decisions")

  // Agent 4: Smart Replier output
  draftReplies       Json?    @map("draft_replies")
  selectedReplyIndex Int?     @map("selected_reply_index")
  replySent          Boolean  @default(false) @map("reply_sent")
  replySentAt        DateTime? @map("reply_sent_at")

  // Processing metadata
  processingTimeMs Int?      @map("processing_time_ms")
  pipelineErrors   Json?     @map("pipeline_errors")
  processedAt      DateTime  @default(now()) @map("processed_at")
  emailDate        DateTime? @map("email_date")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]
  feedbacks UserFeedback[]

  @@unique([userId, gmailMessageId])
  @@index([userId, priorityLevel])
  @@index([userId, processedAt])
  @@index([gmailThreadId])
  @@map("processed_emails")
}

// ─── Reminders ────────────────────────────────────────────────

model Reminder {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  emailId         String?  @map("email_id")
  reminderType    String   @map("reminder_type")  // 'deadline', 'follow_up', 'snooze', 'custom'
  remindAt        DateTime @map("remind_at")
  message         String
  emailSubject    String?  @map("email_subject")
  emailFrom       String?  @map("email_from")
  escalationLevel Int      @default(0) @map("escalation_level")
  relatedDeadline DateTime? @map("related_deadline")
  isSent          Boolean  @default(false) @map("is_sent")
  isDismissed     Boolean  @default(false) @map("is_dismissed")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email ProcessedEmail? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([userId, isActive, remindAt])
  @@index([remindAt, isSent])
  @@map("reminders")
}

// ─── User Feedback (Learning Loop) ───────────────────────────

model UserFeedback {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  emailId        String?  @map("email_id")
  agentName      String   @map("agent_name")
  feedbackType   String   @map("feedback_type")
  originalValue  Json?    @map("original_value")
  correctedValue Json?    @map("corrected_value")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email ProcessedEmail? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([userId, agentName])
  @@index([agentName, feedbackType])
  @@map("user_feedback")
}

// ─── Agent Processing Log ────────────────────────────────────

model AgentLog {
  id            String   @id @default(uuid())
  emailId       String   @map("email_id")
  agentName     String   @map("agent_name")
  status        String   // 'started', 'completed', 'error', 'skipped'
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  durationMs    Int?     @map("duration_ms")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([emailId])
  @@index([agentName, status])
  @@index([createdAt])
  @@map("agent_logs")
}

// ─── Company Knowledge (RAG) ─────────────────────────────────

model CompanyKnowledge {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  division  String   // 'CS', 'Logistik', 'Finance'
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("company_knowledge")
}
